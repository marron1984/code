{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist/assets",
    "rootDir": "src",
    "jsx": "react-jsx",
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src"]
}
